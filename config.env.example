# Copy to config.env (repo root) and fill in. Never commit the real config.env.
# Optional settings are commented out: leave them commented to use the default
# (an empty value counts as "set" and overrides the default).

# Command prefix, e.g. "." for .ping
PREFIX=.
# Extra numbers allowed to use the bot (comma separated, with country code)
# SUDO=919876543210
# private (only you + SUDO) or public
WORK_TYPE=private
# COUNTRY_CODE=91

# Database: default is the local SQLite file ./PritamApp.db
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Azure OpenAI key used by src/services/openai (sent as the "api-key" header)
AZURE_OPENAI_KEY=your-azure-openai-key

# Optional keys for some commands
# OPEN_AI_KEY=sk-your-openai-key
# OCR_API_KEY=your-ocr-space-key
# CURRENT_WEATHER_API_KEY=your-openweathermap-key
# NEWS_API_URL=https://your-news-api
# STRING_SESSION=
# DEBUG=false
